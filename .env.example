APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/orchestrator?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080

SESSION_SECRET=super-secret-session-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$some-salt$some-hash

BOOTSTRAP_TOKEN_TTL=15m

HEARTBEAT_INTERVAL=30s
HEARTBEAT_TIMEOUT=90s

TASK_LEASE_DURATION=10m
TASK_MAX_ATTEMPTS=5

LOG_LEVEL=info

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=backlink-data
