# Caddyfile for Backlink Orchestrator
# Assumes Orchestrator runs locally on port 8080

{
    email {$ADMIN_EMAIL:admin@example.com}
}

{$ORCHESTRATOR_DOMAIN} {
    # Secure the metrics endpoint - only allow from localhost
    @externalMetrics {
        path /metrics
        not remote_ip 127.0.0.1 ::1
    }
    respond @externalMetrics 403

    # Reverse proxy to the Go backend
    reverse_proxy 127.0.0.1:8080

    # Compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/orchestrator.log
        format json
    }
}
